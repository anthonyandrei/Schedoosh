# Schedoosh Environment Variables Template
# Copy this file to .env.local and fill in your values.

# Google OAuth & Calendar Integration (Optional)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_API_KEY=your_google_api_key_here

# Upstash Redis Rate Limiting (Optional)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Semester Start Date Configuration (Format: "MMM D, YYYY" e.g. "MAY 5, 2025")
NEXT_PUBLIC_NEXT_SEMESTER_DATE="MAY 5, 2025"

# Umami Analytics (Optional)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your_umami_website_id_here

# Local Development / Mock Scraping (Optional: set to "true" to use mock fixtures)
ARCHERSHUB_MOCK_MODE=false
